{
  "name": "salon-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --require ts-node/register src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "test": "node --require ./test/register.js --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:migrate:dev": "node ./node_modules/ts-node/dist/bin.js src/scripts/migrate.ts",
    "admin:reset-password": "node ./node_modules/ts-node/dist/bin.js src/scripts/resetAdminPassword.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
