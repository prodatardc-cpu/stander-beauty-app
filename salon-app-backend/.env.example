# Copier en .env (jamais commité) et remplacer chaque valeur. Valeurs ci-dessous = exemples.

# --- Base PostgreSQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salon_coiffure
DB_USER=postgres
DB_PASSWORD=change-me

# --- Serveur -------------------------------------------------------------------
PORT=3000
# "production" en production : configuration vérifiée strictement au démarrage, migrations non
# appliquées automatiquement, en-tête HSTS.
NODE_ENV=development
# Origine(s) exacte(s) de l'application web, séparées par des virgules, sans chemin.
# Obligatoire en production (https), ex. : https://salon.example.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Nombre de proxys devant l'API (souvent 1 chez Render, Railway, Heroku, derrière Nginx…) pour que
# la limitation des tentatives de connexion voie l'adresse réelle des visiteurs. Vide en local.
TRUST_PROXY=
# Migrations au démarrage : true par défaut hors production, false en production
# (lancer alors `npm run db:migrate` pendant le déploiement).
# DB_AUTO_MIGRATE=false

# --- Authentification ------------------------------------------------------------
# Secret de signature des jetons : 32 caractères aléatoires au minimum, propre à chaque
# environnement (ex. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret
# Durée de vie d'un jeton (il est renouvelé à chaque ouverture de l'application).
JWT_EXPIRE=12h
# Au-delà de ce nombre de jours après la connexion, une nouvelle connexion est exigée.
SESSION_MAX_DAYS=7

# --- Premier démarrage uniquement ------------------------------------------------
# Crée le compte administrateur s'il n'en existe aucun. Retirer ces lignes une fois le compte créé.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=<au moins 12 caractères, unique>

# --- Tests (npm test) --------------------------------------------------------------
# Base dédiée, créée si besoin puis vidée par les tests ; son nom doit finir par _test
# (par défaut : <DB_NAME>_test).
# TEST_DB_NAME=salon_coiffure_test
